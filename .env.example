# ── 运行环境 ─────────────────────────────────────────
# 运行模式：development | production | test
NODE_ENV=development

# ── 数据库 ──────────────────────────────────────────
# PostgreSQL 连接串（用户名/密码/主机/端口/库名）
DATABASE_URL=postgresql://postgres:password@localhost:5432/wallet_data
# API 连接池最大连接数（查询接口专用，与 worker 分池）
DB_API_POOL_MAX=8
# Worker 连接池最大连接数（索引器、物化同步专用）
DB_WORKER_POOL_MAX=12
# 全局写事务并发上限（persist / reorg / 余额物化同时进行的最大事务数）
DB_MAX_CONCURRENT_WRITE_TX=3
# 获取数据库连接的超时时间（毫秒）
DB_CONNECTION_TIMEOUT_MS=5000
# 空闲连接在池中保留的最长时间（毫秒）
DB_IDLE_TIMEOUT_MS=30000
# API 池单条 SQL 语句超时（毫秒）
DB_API_STATEMENT_TIMEOUT_MS=15000
# Worker 池单条 SQL 语句超时（毫秒，回填等长事务需更大）
DB_WORKER_STATEMENT_TIMEOUT_MS=120000

# ── Redis ────────────────────────────────────────────
# Redis 连接串（缓存、鉴权 token 等）
REDIS_URL=redis://localhost:6379

# ── 链 RPC ───────────────────────────────────────────
# 目标链 ID（1 = Ethereum 主网）；须与 RPC eth_chainId 一致
CHAIN_ID=1
# HTTP RPC 端点（回填、anchor、健康检查等轮询请求）
RPC_HTTP_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
# WebSocket RPC 端点（ERC20/NFT 实时 Transfer 订阅）
RPC_WS_URL=wss://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# ── HTTP API ─────────────────────────────────────────
# HTTP 服务监听端口
PORT=3000
# 浏览器跨域白名单（逗号分隔）；留空则拒绝所有跨域请求
# CORS_ORIGINS=http://localhost:5173,https://app.example.com
# 请求 JSON body 大小上限
JSON_BODY_LIMIT=32kb
# JWT 签名密钥（至少 32 字符）
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
# JWT 有效期（秒）
JWT_TTL_SECONDS=3600

# ── Indexer 参数 ──────────────────────────────────────
# 确认深度：仅索引 safeLatest = 链头 - CONFIRMATION_DEPTH 及以前的块
CONFIRMATION_DEPTH=12
# 单次 eth_getLogs 回填的最大块范围
BACKFILL_MAX_BLOCK_RANGE=2000
# WebSocket 重连后从 safeLatest 往回重叠扫描的块数（防漏块）
BACKFILL_OVERLAP_BLOCKS=2
# 无 checkpoint 时相对安全块高的最大回看块数；start_block 为 NULL 时以此为下界
INDEXER_START_LOOKBACK_BLOCKS=100
# 热层保留块数（超过后由归档任务迁移；须与 migration 分区策略一致）
HOT_RETAIN_BLOCKS=648000
# 每个热分区的块高跨度
PARTITION_BLOCK_RANGE=500000
# 定时预创建热分区的间隔（毫秒）
PARTITION_ENSURE_INTERVAL_MS=300000
# reorg 扫描时向上回溯的最大块数
REORG_SCAN_DEPTH=128
# 定时 reorg 扫描间隔（毫秒）
REORG_SCAN_INTERVAL_MS=60000
# 定时 gap-backfill 间隔：将各合约 checkpoint 追至安全块高（补空块 anchor）
GAP_BACKFILL_INTERVAL_MS=60000
# live 路径单次事务内联补洞的最大块数；更大 gap 由定时 backfill 处理
MAX_INLINE_GAP_BLOCKS=500
# 链级 anchor 回填时 eth_getBlock 并发上限
ANCHOR_PREFETCH_CONCURRENCY=32
# 归档层 reorg 修复时的安全边距块数
ARCHIVE_REORG_SAFETY_MARGIN=128

# ── Wallet Sync Workers ───────────────────────────────
# ERC20 余额物化同步间隔（毫秒）
BALANCE_SYNC_INTERVAL_MS=30000
# NFT 持有物化同步间隔（毫秒）
NFT_SYNC_INTERVAL_MS=30000

# ── 日志 ─────────────────────────────────────────────
# 日志级别：fatal | error | warn | info | debug | trace（trace 最详细，含全部数据流）
LOG_LEVEL=info
# 日志文件路径（留空则仅输出到终端）；配置后终端与文件双写，目录不存在会自动创建
# LOG_FILE=logs/app.log
